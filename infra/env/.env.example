# 本地开发环境模板。复制为 infra/env/.env.local 后按需修改。
# 该文件只包含本地占位值：不得提交真实密码、服务令牌或模型供应商密钥。

# PostgreSQL
POSTGRES_DB=cert_practice
POSTGRES_USER=cert_practice
POSTGRES_PASSWORD=local-only-password
POSTGRES_PORT=5432

# AI 供应商共享配置。Java 读取 AI_PROVIDER/AI_MODEL 记录生成元数据；
# Python 读取完整供应商配置。默认 mock 无需外部密钥；切换真实供应商时
# 填写 OpenAI-compatible 地址与密钥，密钥只写入本地环境文件。
AI_PROVIDER=mock
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_MODEL=mock-model
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30

# Java 业务服务
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/cert_practice
DATABASE_USERNAME=cert_practice
DATABASE_PASSWORD=local-only-password
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=30
# 登录失败限流：默认 5 次失败后锁定 15 分钟。
LOGIN_THROTTLE_ENABLED=true
LOGIN_THROTTLE_MAX_FAILURES=5
LOGIN_THROTTLE_FAILURE_WINDOW=15m
LOGIN_THROTTLE_LOCK_DURATION=15m
# 批量导入上传上限；业务层与 Servlet 层双重限制。
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
QUESTION_IMPORT_MAX_FILE_BYTES=10485760
JAVA_AI_BASE_URL=http://localhost:8000
# Java 调用 Python 的内部令牌；Python 服务读取同名变量，两端必须一致。
JAVA_AI_SERVICE_TOKEN=local-internal-token
JAVA_AI_CONNECT_TIMEOUT_SECONDS=5
JAVA_AI_REQUEST_TIMEOUT_SECONDS=30
# AI 额度与生成默认值；管理员可在管理端通过版本化配置覆盖。
AI_DAILY_REQUEST_LIMIT=10
AI_SESSION_TURN_LIMIT=20
AI_MAX_INPUT_CHARS=2000
AI_TEAM_DAILY_BUDGET=1.0
AI_RESERVED_COST=0.001
AI_SEND_OFFICIAL_ANSWER=false
AI_GENERATION_SCHEDULER_ENABLED=true
AI_GENERATION_POLL_DELAY_MS=5000
AI_GENERATION_LEASE_DURATION=2m
AI_GENERATION_MAX_ATTEMPTS=3
AI_GENERATION_DEFAULT_TARGET_COUNT=30
AI_PROMPT_VERSION=v1

# Python AI 服务
LOG_LEVEL=INFO

# Vue 开发服务器代理。Vite 从 frontend/.env* 或 shell 环境读取；
# 需要在仓库根目录统一管理时，先导出该变量再启动 pnpm dev。
VITE_API_PROXY_TARGET=http://localhost:8080
