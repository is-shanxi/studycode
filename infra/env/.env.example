# 本地开发环境模板。复制为 infra/env/.env.local 后按需修改。
# 该文件只包含本地占位值：不得提交真实密码、服务令牌或模型供应商密钥。

# PostgreSQL
POSTGRES_DB=cert_practice
POSTGRES_USER=cert_practice
POSTGRES_PASSWORD=local-only-password
POSTGRES_PORT=5432

# Java 业务服务
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/cert_practice
DATABASE_USERNAME=cert_practice
DATABASE_PASSWORD=local-only-password
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_MINUTES=30
JAVA_AI_BASE_URL=http://localhost:8000
# Java 调用 Python 的内部令牌；Python 服务读取同名变量，两端必须一致。
JAVA_AI_SERVICE_TOKEN=local-internal-token
JAVA_AI_CONNECT_TIMEOUT_SECONDS=5
JAVA_AI_REQUEST_TIMEOUT_SECONDS=30

# Python AI 服务
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30

# Vue 开发服务器代理
VITE_API_PROXY_TARGET=http://localhost:8080
